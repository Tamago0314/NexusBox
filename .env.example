# ---- Discord ----
# Discord Developer Portal > Bot > Token
# Bot 設定で "MESSAGE CONTENT INTENT" と "SERVER MEMBERS INTENT" を有効にしておくこと
DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- VOICEVOX ENGINE ----
# compose.yaml のサービス名。compose で動かすならこのままでよい
VOICEVOX_URL=http://voicevox:50021

# ENGINE への同時合成リクエスト数。CPU では増やしすぎるとかえって遅くなる
SYNTHESIS_CONCURRENCY=2

# ---- BOT ----
DATABASE_PATH=data/nexusbox.db
LOG_LEVEL=INFO

# ---- 声 (BOT 全体で固定。変更したら再起動が必要) ----
# 話者 ID (3 = ずんだもん ノーマル)
DEFAULT_SPEAKER_ID=3

# 話速 0.5〜2.0
DEFAULT_SPEED=1.0
# 音高 -0.15〜0.15
DEFAULT_PITCH=0.0
# 抑揚 0.0〜2.0 (0 で棒読み)
DEFAULT_INTONATION=1.0
# 音量 0.0〜2.0
DEFAULT_VOLUME=1.0

# 合成済み WAV の LRU キャッシュ件数
CACHE_SIZE=256

# 1 ギルドあたりの読み上げキュー上限 (溢れた分は捨てられる)
MAX_QUEUE_SIZE=20

# 開発用: ここにギルド ID をカンマ区切りで書くとそのサーバーにだけ即座にコマンドが同期される
# 空にするとグローバル同期 (反映に最大 1 時間)
GUILD_IDS=
